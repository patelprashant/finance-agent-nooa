# Secrets — never commit your real key
.env

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# On-disk categorization cache
.cache/
# Workflow/agent build artifacts (reviews, task notes)
.agents/
# NOOA trace journals (created when you run with the trace viewer)
.nooa/
*.journal

# Blog/doc drafts — kept on disk, not tracked
/docs/

# Kiro specs/hooks/settings — kept on disk, not tracked
/.kiro/
